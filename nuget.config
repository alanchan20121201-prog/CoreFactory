<?xml version="1.0" encoding="utf-8"?>
<!--
  Godot 的 C# 套件（Godot.NET.Sdk / GodotSharp）在 nuget.org 上有，
  但這台機器同時也能離線編譯：Godot 安裝目錄自帶 nupkgs。
  若你的 Godot 裝在別的路徑，改下面的 GodotOffline 即可（或直接刪掉這一段）。
-->
<configuration>
  <packageSources>
    <add key="GodotOffline" value="C:\Users\alanc\Desktop\Godot_v4.7.2-stable_mono_win64\GodotSharp\Tools\nupkgs" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
